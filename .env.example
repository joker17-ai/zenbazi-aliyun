# ZenBazi cloud-aligned local debug profile
# Copy to `.env.local` for local use.
# Cloud Toolkit injected environment variables take precedence over this file.

# Runtime
PORT=8787
STORAGE_ROOT=cloud
ZENBAZI_ENABLE_RATE_LIMIT=false

# PostgreSQL
# Prefer DATABASE_URL. The PG* fields are fallback options.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=zenbazi
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PGPOOL_MAX=10

# Admin
ZENBAZI_ADMIN_SECRET=replace-with-a-long-random-secret
ZENBAZI_ADMIN_JWT_SECRET=replace-with-a-second-long-random-secret
ZENBAZI_ADMIN_USER=admin
ZENBAZI_ADMIN_PASSWORD=change-me

# Queue
# Leave REDIS_URL empty to use the in-memory queue.
REDIS_URL=
REDIS_QUEUE_NAME=zenbazi

# Object storage
# This project currently expects an S3-compatible object storage endpoint.
# If your Alibaba Cloud OSS setup is not S3-compatible, keep STORAGE_DRIVER local
# or add a dedicated OSS adapter before switching this on.
STORAGE_DRIVER=local
S3_BUCKET=
S3_PREFIX=zenbazi-secure
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI
DEEPSEEK_API_KEY=

# Payments
# Direct gateway payments require PostgreSQL and HTTPS callbacks.
PAYMENT_CALLBACK_BASE_URL=https://yuandestiny.cn
PAYMENT_TOKEN_SECRET=replace-with-at-least-32-random-characters

# WeChat Pay API v3 Native
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=

# Alipay QR payment (alipay.trade.precreate)
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
